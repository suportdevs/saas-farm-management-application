# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME="HerdSphere"
# Public URL of the web app (used in emails and OAuth redirects)
WEB_URL=http://localhost:3000
# Comma separated origins allowed by CORS (only needed if the browser calls the API directly)
CORS_ORIGINS=http://localhost:3000
# Which proxies to trust for X-Forwarded-For (client IP). "loopback" trusts the
# Next.js server on the same host. Use a hop count (e.g. 1) behind a load balancer.
TRUST_PROXY=loopback
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgres://herdsphere:herdsphere@localhost:5434/herdsphere
# Integration tests (npm test) use a separate database, created by docker/postgres/init.
TEST_DATABASE_URL=postgres://herdsphere:herdsphere@localhost:5434/herdsphere_test

# ─── Security ─────────────────────────────────────────
# 32+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-32-chars
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=30

# ─── Mail ─────────────────────────────────────────────
# Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="HerdSphere <no-reply@example.com>"

# ─── Auth behaviour ───────────────────────────────────
# off | optional | required — "required" blocks the app until the email is verified
EMAIL_VERIFICATION=optional
# Failed sign-ins per account+IP before a temporary lock (0 = disabled)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Simple math captcha on the listed forms
CAPTCHA_ENABLED=false
CAPTCHA_FORMS=login,register,forgot-password,magic-link
# Comma separated: these addresses become admins once verified
ADMIN_EMAILS=
SEND_WELCOME_EMAIL=true

# ─── Scaling ──────────────────────────────────────────
# "postgres" shares rate-limit counters across API instances (use it in production
# when running more than one instance). "memory" keeps them per process.
RATE_LIMIT_STORE=memory
# Process background jobs (emails, cleanup, module jobs) inside the API process.
# Set to false if you run a dedicated worker: `npm run worker -w @kit/api`.
RUN_WORKER=true
JOB_POLL_INTERVAL_MS=1000
JOB_CONCURRENCY=5
AUDIT_LOG_RETENTION_DAYS=365

# ─── Modules ──────────────────────────────────────────
# Variables for installed modules are appended below by `npm run kit add <module>`.

# ─── Farms (tenants) & subscriptions ──────────────────
# Every new farm gets a free trial of FARM_TRIAL_PLAN (0 = no trial).
FARM_TRIAL_DAYS=14
FARM_TRIAL_PLAN=pro
# Farms a single user may own.
FARM_MAX_OWNED=10
# Stripe (optional — online checkout stays off until STRIPE_SECRET_KEY is set).
# Webhook endpoint: <WEB_URL>/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
