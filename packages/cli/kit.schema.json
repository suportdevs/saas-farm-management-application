{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kit.json",
  "description": "Tracks installed starter-kit modules. Managed by `npm run kit` — avoid editing by hand.",
  "type": "object",
  "properties": {
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "installedAt": { "type": "string" },
          "files": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
